---
import navData from "../../../data/navigation.json";
import styles from "./Header.module.css";
import { NavigationSchema, type Mode } from "../../content/sassdoc-schema";
import { getConfig } from "../../utils";
import { getChrome } from "../../utils/chrome";
import { getLangFromEnv, useTranslations } from "../../i18n";

const lang = getLangFromEnv();
const mode = import.meta.env.MODE as Mode;
const t = useTranslations(lang);
const siteBase = import.meta.env.BASE_URL;

const { url: baseUrl, versions: versionsURL } = getConfig(lang, mode);
const chrome = getChrome(lang);
const header = chrome?.header ?? NavigationSchema.parse(navData).header;
---

<div class="main-nav">
  <Fragment set:html={header} />
</div>

<div class:list={["main-head", styles.secondaryHead]}>
  <section class={styles.secondaryHead__section}>
    <a
      class={styles.secondaryHead__brand}
      href=`${baseUrl}/products/ignite-ui-angular`
    >
      <span class={styles.secondaryHead__title}>Ignite UI</span>
    </a>
    <span class={styles.secondaryHead__badge}>{t("header.badge")}</span>
  </section>

  <section class={styles.secondaryHead__section}>
    <select
      class={styles.secondaryHead__select}
      id="version-selector"
      aria-label={t("header.version")}
      data-site-base={siteBase}
      data-versions-url={versionsURL}
      data-base-url={baseUrl}
      data-mode={mode}
    >
    </select>
    <a
      tabindex="0"
      href=`${baseUrl}/products/ignite-ui-angular`
      class={styles.secondaryHead__button}
      data-type="flat"
      target="_blank"
    >
      {t("header.actions.components")}
    </a>
    <a
      tabindex="0"
      href=`${baseUrl}/products/ignite-ui-angular/getting-started/`
      class={styles.secondaryHead__button}
      data-type="contained"
      target="_blank"
    >
      {t("header.actions.get-started")}
    </a>
  </section>
</div>
<script>
  const select = document.querySelector(
    "#version-selector",
  ) as HTMLSelectElement;

  interface Version {
    version: string;
    url: string;
  }

  interface VersionsResponse {
    versions: Version[];
  }

  async function loadVersions(): Promise<void> {
    try {
      const mode = select.dataset.mode;
      const siteBase = select.dataset.siteBase || "/";
      const versionsURL = select.dataset.versionsUrl;
      const baseUrl = select.dataset.baseUrl;
      let versions: Version[];

      if (!versionsURL || !baseUrl) {
        throw new Error("Missing configuration data");
      }

      if (mode !== "development") {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 5000);

        const response = await fetch(versionsURL, { signal: controller.signal });
        clearTimeout(timeout);

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        // External API returns { folders: [...] }
        const payload = await response.json();
        versions = payload.folders
          .map((version: string) => ({
            version,
            url: `${baseUrl}/products/ignite-ui-angular/docs/${version}/sass/`,
          }))
          .reverse();
      } else {
        versions = [{ version: "dev", url: "#" }];
      }

      select.innerHTML = versions
        .map(
          ({ version, url }: Version) =>
            `<option value="${url}">${version}</option>`,
        )
        .join("");
    } catch (error) {
      console.error("Failed to fetch versions:", error);
      select.innerHTML = '<option value="#">Error loading versions</option>';
    }
  }

  loadVersions();

  select.addEventListener("change", () => {
    const url = select.value;
    if (url && url !== "#") {
      window.location.assign(url);
    }
  });
</script>
