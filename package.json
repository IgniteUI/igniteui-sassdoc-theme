{
  "name": "igniteui-sassdoc-theme",
  "description": "Default SassDoc theme used in Ignite UI for Angular.",
  "author": "Infragistics",
  "license": "MIT",
  "type": "module",
  "version": "3.0.0",
  "files": [
    "sassdoc/"
  ],
  "keywords": [
    "sassdoc",
    "theme",
    "styles api",
    "custom"
  ],
  "scripts": {
    "build": "npm run scss:build && vite build && node ./scripts/post-build.js",
    "compile": "npm run build && sassdoc ./test/library -c ./test/sassdoc.config.json",
    "dev": "npm run compile && node ./scripts/copy-data.js && concurrently --kill-others --names scss,astro \"npm:scss:watch\" \"astro dev --host\"",
    "serve": "npm run compile && node ./scripts/serve.js",
    "scss:build": "sass src:src --quiet-deps --load-path=node_modules --no-source-map --style=compressed",
    "scss:watch": "npm run scss:build -- --watch",
    "chrome:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/chrome-sync.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "igniteui-theming": "^30.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sassdoc": "^2.7.4",
    "serve-handler": "^6.1.7",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "astro-breadcrumbs": "^3.4.2",
    "astro-expressive-code": "^0.44.3",
    "astro-pagefind": "^2.0.1",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "sass-embedded": "^1.106.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nunjucks": {
      "chokidar": "^5.0.0"
    },
    "sass-convert": {
      "semver-regex": "^3.1.4"
    }
  }
}
